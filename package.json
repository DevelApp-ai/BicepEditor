{
  "name": "bicep-blockly-editor",
  "version": "1.0.0",
  "description": "Visual editor for Azure Bicep with module support using Google Blockly",
  "main": "dist/main.js",
  "scripts": {
    "start": "electron .",
    "build": "webpack --config webpack.config.js",
    "watch": "webpack --config webpack.config.js --watch",
    "dev": "npm run build && npm run start",
    "test": "node tests/run-all-tests.js",
    "test:core": "electron tests/core-functionality.test.js",
    "test:modules": "electron tests/module-analysis.test.js",
    "test:flags": "electron tests/feature-flags.test.js",
    "test:platform": "electron tests/cross-platform.test.js",
    "package": "electron-builder build --mac --win --linux",
    "package:win": "electron-builder build --win",
    "package:mac": "electron-builder build --mac",
    "package:linux": "electron-builder build --linux"
  },
  "keywords": [
    "bicep",
    "blockly",
    "azure",
    "visual-programming",
    "infrastructure-as-code"
  ],
  "author": "",
  "license": "MIT",
  "build": {
    "appId": "com.bicep.blockly.editor",
    "productName": "Bicep Blockly Editor",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "package.json",
      "index.html",
      "styles.css"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icons/mac/icon.icns"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icons/win/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Development",
      "icon": "assets/icons/png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
