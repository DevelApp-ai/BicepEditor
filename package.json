{
  "name": "bicep-blockly-editor",
  "version": "1.0.0",
  "description": "Visual editor for Azure Bicep with module support using Google Blockly",
  "main": "dist/main.js",
  "scripts": {
    "start": "electron .",
    "build": "webpack --config webpack.config.js",
    "watch": "webpack --config webpack.config.js --watch",
    "dev": "npm run build && npm run start",
    "test": "node tests/run-all-tests.js",
    "test:core": "electron tests/core-functionality.test.js",
    "test:modules": "electron tests/module-analysis.test.js",
    "test:flags": "electron tests/feature-flags.test.js",
    "test:platform": "electron tests/cross-platform.test.js",
    "package": "electron-builder build --mac --win --linux",
    "package:win": "electron-builder build --win",
    "package:mac": "electron-builder build --mac",
    "package:linux": "electron-builder build --linux",
    "prepare-package": "node scripts/prepare-package.js",
    "postinstall": "electron-builder install-app-deps",
    "lint": "tsc --noEmit && eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.{ts,js,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json}\"",
    "clean": "rm -rf dist",
    "audit": "npm audit --audit-level=moderate",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "bicep",
    "blockly",
    "azure",
    "visual-programming",
    "infrastructure-as-code"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "blockly": "^10.0.0",
    "simple-git": "^3.16.0"
  },
  "devDependencies": {
    "@types/node": "^18.11.18",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "css-loader": "^6.7.3",
    "electron": "^23.1.0",
    "electron-builder": "^23.6.0",
    "eslint": "^8.45.0",
    "prettier": "^3.0.0",
    "style-loader": "^3.3.1",
    "ts-loader": "^9.4.2",
    "typescript": "^4.9.5",
    "webpack": "^5.75.0",
    "webpack-cli": "^5.0.1"
  },
  "build": {
    "appId": "com.bicep.blockly.editor",
    "productName": "Bicep Blockly Editor",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "package.json",
      "index.html",
      "styles.css"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icons/mac/icon.icns"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icons/win/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Development",
      "icon": "assets/icons/png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
