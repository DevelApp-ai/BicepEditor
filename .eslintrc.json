{
  "env": {
    "browser": true,
    "node": true,
    "es2021": true
  },
  "extends": [
    "eslint:recommended"
  ],
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "plugins": [
    "@typescript-eslint"
  ],
  "rules": {
    "@typescript-eslint/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_"
      }
    ],
    "@typescript-eslint/no-explicit-any": "error",
    "@typescript-eslint/no-non-null-assertion": "error",
    "no-console": "error",
    "prefer-const": "error",
    "no-var": "error",
    "eqeqeq": "error",
    "curly": "error"
  },
  "ignorePatterns": [
    "dist/**/*",
    "node_modules/**/*",
    "release/**/*",
    "*.config.js",
    "tests/**/*"
  ],
  "overrides": [
    {
      "files": [
        "src/main/**/*.ts",
        "src/common/feature-flag-manager.ts"
      ],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": [
        "src/renderer/**/*.ts"
      ],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}