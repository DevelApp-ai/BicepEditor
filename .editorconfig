# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# All files
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# TypeScript and JavaScript files
[*.{ts,js}]
indent_size = 2

# JSON files
[*.json]
indent_size = 2

# YAML files  
[*.{yml,yaml}]
indent_size = 2

# Markdown files
[*.md]
trim_trailing_whitespace = false

# Bicep files
[*.bicep]
indent_size = 2

# HTML files
[*.html]
indent_size = 2

# CSS/SCSS files
[*.{css,scss}]
indent_size = 2

# Batch files (Windows)
[*.{bat,cmd}]
end_of_line = crlf

# Package files
[package*.json]
indent_size = 2

# Configuration files
[*.config.{js,ts}]
indent_size = 2

# Dockerfile
[Dockerfile*]
indent_size = 4