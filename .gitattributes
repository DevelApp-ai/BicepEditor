# Auto detect text files and perform LF normalization
* text=auto

# Ensure consistent line endings for specific file types
*.ts text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.bicep text eol=lf
*.html text eol=lf
*.css text eol=lf
*.scss text eol=lf

# Windows batch files should use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell scripts should use LF
*.sh text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.dmg binary
*.zip binary
*.tar.gz binary
*.exe binary
*.msi binary
*.deb binary
*.rpm binary

# Electron specific
*.node binary
*.app binary

# Archive files
*.7z binary
*.gz binary
*.tar binary
*.zip binary
*.rar binary

# Fonts
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary